"""Migration v3 - properly handles unknown columns"""
import json, time, re
from supabase import create_client

NEW_URL = "https://kosmdtcrrklaalfyxmlc.supabase.co"
NEW_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtvc21kdGNycmtsYWFsZnl4bWxjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTY0NDc2MywiZXhwIjoyMDk1MjIwNzYzfQ.cpyAuoLRASuypLyG7c37rOi25hAA5QoN-Au5KmWRHp0"

new = create_client(NEW_URL, NEW_KEY)

with open('/tmp/supabase_backup.json', 'r') as f:
    exported = json.load(f)

TABLES = [
    'notification_settings', 'bots', 'categories', 'products',
    'subscription_plans', 'payment_methods', 'payment_order',
    'bot_languages', 'product_payment_method_assignments',
    'invite_codes', 'user_languages', 'user_balances',
    'balance_transactions', 'sales', 'manual_payments',
    'coupons', 'coupon_redemptions', 'user_subscriptions',
    'balance_transfers',
]

print("IMPORTING DATA TO NEW SUPABASE (v3)")
print("=" * 50)

for t in TABLES:
    data = exported.get(t, [])
    if not data:
        print(f"  ⏭️  {t}: empty")
        continue
    
    # First pass: find bad columns by testing first row
    bad_cols = set()
    test_row = dict(data[0])
    
    for attempt in range(10):
        for bc in list(bad_cols):
            test_row.pop(bc, None)
        try:
            new.table(t).upsert(test_row).execute()
            break
        except Exception as e:
            err_msg = str(e)
            # Extract column name from error like: "Could not find the 'xxx' column"
            match = re.search(r"Could not find the '(\w+)' column", err_msg)
            if match:
                col = match.group(1)
                bad_cols.add(col)
                test_row.pop(col, None)
                continue
            elif "violates foreign key" in err_msg:
                break
            else:
                print(f"    ⚠️  {t} test: {err_msg[:150]}")
                break
    
    if bad_cols:
        print(f"  🔧 {t}: stripping columns {bad_cols}")
    
    # Second pass: import all rows with bad columns removed
    success = 0
    failed = 0
    
    for row in data:
        clean_row = {k: v for k, v in row.items() if k not in bad_cols}
        try:
            new.table(t).upsert(clean_row).execute()
            success += 1
        except Exception as e:
            failed += 1
            if failed <= 2:
                print(f"    ❌ {t}: {str(e)[:150]}")
    
    print(f"  ✅ {t}: {success} imported, {failed} failed")
    time.sleep(0.3)

print("\n" + "=" * 50)
print("✅ MIGRATION COMPLETE!")
print("=" * 50)
