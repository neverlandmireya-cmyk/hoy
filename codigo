    @staticmethod
    async def successful_payment_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
        pay = update.message.successful_payment
        parts = pay.invoice_payload.split('_')
        uname = update.effective_user.username or "Unknown"
        
        # Handle balance recharge: rcharge_{bot_id}_{uid}_{amount}_{main_bun}
        if parts[0] == 'rcharge':
            bot_id = parts[1]
            tid = int(parts[2])
            amount = float(parts[3])
            br = supabase.table('bots').select('*').eq('id', bot_id).execute()
            bot_config = br.data[0] if br.data else {}
            ref = f"STARS_RECHARGE_{pay.telegram_payment_charge_id}"
            ex = supabase.table('balance_transactions').select('id').eq('reference', ref).execute()
            if not ex.data:
                add_balance_transaction(tid, bot_id, amount, 'recharge', reference=ref, description=f"Stars recharge ({pay.total_amount} ⭐)")
                if bot_config.get('bot_username') in active_bots:
                    try:
                        lang = get_user_language(tid, bot_id)
                        new_bal = get_user_balance(tid, bot_id)
                        await active_bots[bot_config['bot_username']].bot.send_message(chat_id=tid, text=t('balance_recharged', lang, balance=f"{new_bal:.2f}"))
                    except: pass
                await send_admin_notification(f"Balance recharge\n\nUser ID: {tid}\nAmount: ${amount}\nStars: {pay.total_amount} ⭐\nMethod: Stars")
            return
        
        # Normal product purchase: stars_{pid}_{plan_or_NONE}_{uid}_{main_bun}
        plan_short = None
        main_bun = None
        pid = parts[1]
        if len(parts) >= 5:
            plan_short = parts[2] if parts[2] != 'NONE' else None
            tid = int(parts[3])
            main_bun = '_'.join(parts[4:])
        elif len(parts) == 4:
            plan_short = parts[2] if parts[2] != 'NONE' else None
            tid = int(parts[3])
        else:
            tid = int(parts[2])
        
        pr = supabase.table('products').select('*').eq('id', pid).execute()
        if not pr.data: return
        p = pr.data[0]
        br = supabase.table('bots').select('*').eq('id', p['bot_id']).execute()
        if not br.data: return
        bc = br.data[0]
        plan = find_plan_by_short(plan_short, pid) if plan_short else None
        
        active_coupon = get_active_coupon(tid, bc['id'])
        
        target_bun = main_bun or bc['bot_username']
        await BotManager.deliver_purchase(target_bun, tid, p, bc, plan, uname)
        supabase.table('sales').insert({'bot_id': p['bot_id'], 'product_id': p['id'], 'telegram_user_id': tid, 'telegram_username': uname, 'hotmart_transaction_id': f"STARS_{pay.telegram_payment_charge_id}", 'payment_method': 'Stars', 'amount': p['price'], 'status': 'completed'}).execute()
        await send_sale_notification(p['product_name'], p['price'], p.get('currency', 'USD'), 'Stars', tid, uname, plan['plan_name'] if plan else None, stars_amount=pay.total_amount)
        if active_coupon:
            redeem_coupon(tid, bc['id'], active_coupon['id'], sale_reference=f"STARS_{pay.telegram_payment_charge_id}")

