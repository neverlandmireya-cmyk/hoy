    @staticmethod
    async def text_message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Handle text messages for coupon/recharge/transfer entry"""
        uid = update.effective_user.id
        text = update.message.text.strip()
        
        # If user types a command, clear all waiting states
        if text.startswith('/'):
            context.user_data.pop('waiting_coupon', None)
            context.user_data.pop('waiting_recharge', None)
            context.user_data.pop('waiting_transfer_amount', None)
            context.user_data.pop('waiting_transfer_id', None)
            context.user_data.pop('waiting_bug', None)
            return
        
        # Coupon entry
        if context.user_data.get('waiting_coupon'):
            bot_id = context.user_data.get('waiting_coupon')
            lang = get_user_language(uid, bot_id)
            code = text.upper()
            cr = supabase.table('coupons').select('*').eq('bot_id', bot_id).eq('code', code).eq('is_active', True).limit(1).execute()
            if not cr.data:
                # Stay in waiting state so they can retry
                await update.message.reply_text(t('coupon_invalid', lang), reply_markup=ForceReply(selective=True))
                return
            c = cr.data[0]
            # Check expiration
            if c.get('expires_at'):
                try:
                    exp = datetime.fromisoformat(c['expires_at'].replace('Z', '+00:00')).replace(tzinfo=None)
                    if exp < datetime.now():
                        context.user_data.pop('waiting_coupon', None)
                        await update.message.reply_text(t('coupon_expired', lang))
                        return
                except: pass
            # Check max uses
            if c.get('max_uses') and c.get('current_uses', 0) >= c['max_uses']:
                context.user_data.pop('waiting_coupon', None)
                await update.message.reply_text(t('coupon_max_uses', lang))
                return
            # Success - clear state
            context.user_data.pop('waiting_coupon', None)
            try:
                supabase.table('coupon_activations').insert({
                    'coupon_id': c['id'],
                    'telegram_user_id': uid,
                    'telegram_username': update.effective_user.username or "Unknown",
                    'bot_id': bot_id
                }).execute()
            except: pass
            supabase.table('user_active_coupons').upsert({
                'telegram_user_id': uid, 'bot_id': bot_id, 'coupon_id': c['id'],
                'created_at': datetime.now().isoformat()
            }, on_conflict='telegram_user_id,bot_id').execute()
            await update.message.reply_text(t('coupon_activated', lang))
            return
        
        # Recharge amount entry
        if context.user_data.get('waiting_recharge'):
            bot_id = context.user_data.get('waiting_recharge')
            lang = get_user_language(uid, bot_id)
            try:
                amount = float(text.replace(',', '.'))
                if amount <= 0: raise ValueError()
            except:
                # Stay in waiting state so they can retry
                await update.message.reply_text(t('balance_invalid_amount', lang))
                return
            # Success - clear state
            context.user_data.pop('waiting_recharge', None)
            kb = []
            kb.append([InlineKeyboardButton(t('pay_crypto', lang), callback_data=f"rcharge_crypto_{amount:.2f}")])
            kb.append([InlineKeyboardButton(t('pay_stars', lang), callback_data=f"rcharge_stars_{amount:.2f}")])
            await update.message.reply_text(f"Choose payment method to add ${amount:.2f} to your balance:", reply_markup=InlineKeyboardMarkup(kb))
            return
        
        # Transfer amount entry
        if context.user_data.get('waiting_transfer_amount'):
            bot_id = context.user_data.get('waiting_transfer_amount')
            lang = get_user_language(uid, bot_id)
            try:
                amount = float(text.replace(',', '.'))
                if amount <= 0: raise ValueError()
            except:
                await update.message.reply_text(t('balance_invalid_amount', lang))
                return
            bal = get_user_balance(uid, bot_id)
            if bal < amount:
                await update.message.reply_text(t('transfer_insufficient', lang))
                return
            # Move to next step: ask for recipient ID
            context.user_data.pop('waiting_transfer_amount', None)
