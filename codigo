def get_methods_for_product(product_id, bot_id):
    methods = get_all_manual_methods()
    assignments = get_all_assignments()
    if not methods: return []
    ok_product = set(a.get('method_id') for a in assignments if a.get('product_id') == product_id)
    ok_bot = set(a.get('method_id') for a in assignments if a.get('bot_id') == bot_id and not a.get('product_id'))
    ok_global = set(a.get('method_id') for a in assignments if not a.get('product_id') and not a.get('bot_id'))
    result = []
    for m in methods:
        mid = m['id']
        if mid in ok_product or mid in ok_bot or mid in ok_global:
            result.append(m)
    return result

