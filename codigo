@app.post("/ban-user")
async def ban_user(request: Request):
    """Ban a user from a bot. Optionally also remove their access and kick from channels."""
    try:
        body = await request.json()
        tid = int(body.get('telegram_user_id'))
        bot_id = body.get('bot_id')
        reason = body.get('reason', '')
        remove_access_flag = bool(body.get('remove_access', True))
        
        if not tid or not bot_id:
            raise HTTPException(400, detail="telegram_user_id and bot_id required")
        
        # Insert ban (upsert in case already banned)
        try:
            supabase.table('banned_users').insert({
                'telegram_user_id': tid,
                'bot_id': bot_id,
                'reason': reason or None,
                'banned_at': datetime.now().isoformat()
            }).execute()
        except Exception as e:
            # Maybe already banned - try update
            logger.info(f"Ban insert failed (maybe duplicate), trying update: {e}")
            supabase.table('banned_users').update({
                'reason': reason or None,
                'banned_at': datetime.now().isoformat()
            }).eq('telegram_user_id', tid).eq('bot_id', bot_id).execute()
        
        result = {"status": "success", "banned": True}
        
        if remove_access_flag:
            sc, subc, cc, kc = await _do_remove_access(tid, bot_id, product_id=None, kick=True)
            result.update({"removed_sales": sc, "removed_subscriptions": subc, "released_invite_codes": cc, "kicked_channels": kc})
        
        logger.info(f"Banned user {tid} from bot {bot_id}. Reason: {reason}")
        return result
    except HTTPException: raise
    except Exception as e:
        logger.error(f"Error banning user: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))


