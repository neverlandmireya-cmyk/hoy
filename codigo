                try:
                    pay = update.message.successful_payment
                    logger.info(f"Stars payment received: payload={pay.invoice_payload}, amount={pay.total_amount}")
                    parts = pay.invoice_payload.split('_')
                    uname = update.effective_user.username or "Unknown"
                    plan_short = None
                    main_bun = None
                    # Payload format: stars_{product_id}_{plan_short}_{tid}_{main_bun}
                    # product_id uses hyphens not underscores, but bot username can have underscores
                    # So we parse by known positions
                    prefix = parts[0]  # 'stars'
                    pid = parts[1]     # product UUID (no underscores)
                    if len(parts) >= 5:
                        plan_short = parts[2] if parts[2] != 'NONE' else None
                        tid = int(parts[3])
                        # Everything from parts[4] onwards is the bot username (may contain underscores)
                        main_bun = '_'.join(parts[4:])
                    elif len(parts) == 4:
                        plan_short = parts[2] if parts[2] != 'NONE' else None
                        tid = int(parts[3])
                    else:
                        tid = int(parts[2])
                    
                    logger.info(f"Stars parsed: pid={pid}, tid={tid}, plan={plan_short}, main_bun={main_bun}")
                    
                    pr = supabase.table('products').select('*').eq('id', pid).execute()
                    if not pr.data:
                        logger.error(f"Stars: product not found for pid={pid}")
                        return
                    p = pr.data[0]
                    br = supabase.table('bots').select('*').eq('id', p['bot_id']).execute()
                    if not br.data:
                        logger.error(f"Stars: bot not found for bot_id={p['bot_id']}")
