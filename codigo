async def send_telegram_notification(text):
    """Send notification to admin Telegram group"""
    if not ADMIN_GROUP_ID:
        logger.warning("ADMIN_GROUP_ID not set, skipping telegram notification")
        return
    try:
        for bun, app in active_bots.items():
            try:
                await app.bot.send_message(chat_id=ADMIN_GROUP_ID, text=text)
                logger.info(f"Admin notification sent via {bun}")
                return
