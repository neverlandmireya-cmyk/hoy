def add_balance_transaction(tid, bot_id, amount, type_, reference=None, description="", admin_note=None):
    """Add to user balance and log transaction"""
    try:
        current = get_user_balance(tid, bot_id)
        new_balance = current + float(amount)
        logger.info(f"Balance update: user {tid}, current={current}, amount={amount}, new={new_balance}, type={type_}")
        supabase.table('user_balances').upsert({
            'telegram_user_id': tid, 'bot_id': bot_id, 'balance': new_balance,
            'currency': 'USD', 'updated_at': datetime.now().isoformat()
        }, on_conflict='telegram_user_id,bot_id').execute()
        supabase.table('balance_transactions').insert({
            'telegram_user_id': tid, 'bot_id': bot_id, 'amount': float(amount),
            'type': type_, 'reference': reference, 'description': description, 'admin_note': admin_note
        }).execute()
        return new_balance
