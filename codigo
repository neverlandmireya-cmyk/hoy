                    logger.info(f"Stars delivery result: ok={ok}")
                    supabase.table('sales').insert({'bot_id': p['bot_id'], 'product_id': p['id'], 'telegram_user_id': tid, 'telegram_username': uname, 'hotmart_transaction_id': f"STARS_{pay.telegram_payment_charge_id}", 'payment_method': 'Stars', 'amount': p['price'], 'status': 'completed'}).execute()
                    await send_sale_notification(p['product_name'], p['price'], p.get('currency', 'USD'), 'Stars', tid, uname, plan['plan_name'] if plan else None, stars_amount=pay.total_amount)
                    logger.info(f"Stars bot @{context.bot.username} processed payment from user {tid}")
                except Exception as e:
                    logger.error(f"Stars payment handler error: {e}", exc_info=True)
            
            application.add_handler(PreCheckoutQueryHandler(stars_precheckout))
            application.add_handler(MessageHandler(filters.SUCCESSFUL_PAYMENT, stars_payment))
            
