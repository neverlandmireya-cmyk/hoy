@app.post("/broadcast")
async def broadcast(request: Request):
    try:
        body = await request.json()
        bot_id = body.get('bot_id')
        message = body.get('message', '').strip()
        target = body.get('target', 'all')  # 'all' or 'buyers'
        
        if not bot_id or not message:
            raise HTTPException(400, detail="Missing bot_id or message")
        
        br = supabase.table('bots').select('bot_username').eq('id', bot_id).limit(1).execute()
        if not br.data:
            raise HTTPException(404, detail="Bot not found")
        bun = br.data[0]['bot_username']
        if bun not in active_bots:
            raise HTTPException(400, detail="Bot not running")
        
        # Get user IDs
        user_ids = set()
        if target == 'buyers':
            sales = supabase.table('sales').select('telegram_user_id').eq('bot_id', bot_id).eq('status', 'completed').execute()
            for s in (sales.data or []):
                user_ids.add(s['telegram_user_id'])
        else:
            langs = supabase.table('user_languages').select('telegram_user_id').eq('bot_id', bot_id).execute()
            for l in (langs.data or []):
                user_ids.add(l['telegram_user_id'])
        
        if not user_ids:
            return {"status": "success", "sent": 0, "failed": 0, "total": 0}
        
        # Send in background
        async def do_broadcast():
            sent = 0
            failed = 0
            bot = active_bots[bun].bot
            for uid in user_ids:
                try:
                    await bot.send_message(chat_id=uid, text=message)
                    sent += 1
                except:
                    failed += 1
                await asyncio.sleep(0.05)
            logger.info(f"Broadcast to {bun}: sent={sent}, failed={failed}, total={len(user_ids)}")
            await send_admin_notification(f"📢 Broadcast complete\n\nBot: @{bun}\nSent: {sent}\nFailed: {failed}\nTotal: {len(user_ids)}")
        
        asyncio.create_task(do_broadcast())
        return {"status": "success", "total": len(user_ids), "message": "Broadcasting started"}
    except HTTPException: raise
    except Exception as e:
        logger.error(f"Broadcast error: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))

async def periodic_bot_reload():
    while True:
        try: await BotManager.load_and_start_all_bots()
        except: pass
        await asyncio.sleep(60)

def run_fastapi():
    uvicorn.run(app, host="0.0.0.0", port=8000, log_level="info")

async def main():
    logger.info("Starting Bot Manager...")
    Thread(target=run_fastapi, daemon=True).start()
    await BotManager.load_and_start_all_bots()
    # Start subscription expiration checker
    asyncio.create_task(check_expirations())
    await periodic_bot_reload()

if __name__ == "__main__":
    try: asyncio.run(main())
    except KeyboardInterrupt: asyncio.run(BotManager.stop_all_bots())
