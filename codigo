            # Get all active subscriptions with expires_at set (no joins)
            r = supabase.table('user_subscriptions').select('*').eq('status', 'active').not_.is_('expires_at', 'null').execute()
            
            for sub in (r.data or []):
                try:
                    expires_at = datetime.fromisoformat(sub['expires_at'].replace('Z', '+00:00')).replace(tzinfo=None)
                    diff = (expires_at - now).total_seconds()
                    
                    # Fetch related data separately
                    plan = {}
                    product = {}
                    bot_config = {}
                    if sub.get('plan_id'):
                        pl_r = supabase.table('subscription_plans').select('*').eq('id', sub['plan_id']).limit(1).execute()
                        if pl_r.data: plan = pl_r.data[0]
                    if sub.get('product_id'):
                        pr_r = supabase.table('products').select('*').eq('id', sub['product_id']).limit(1).execute()
                        if pr_r.data: product = pr_r.data[0]
                    if sub.get('bot_id'):
                        bc_r = supabase.table('bots').select('*').eq('id', sub['bot_id']).limit(1).execute()
                        if bc_r.data: bot_config = bc_r.data[0]
                    
                    plan_duration = plan.get('duration_minutes', 0)
                    
                    # Already expired - kick
                    if diff <= 0:
                        await kick_user(sub, bot_config, product)
                        continue
                    
                    # Percentage-based notifications to USER (2 warnings + expired = 3 total)
                    total_secs = plan_duration * 60 if plan_duration > 0 else 0
                    if total_secs > 0:
                        pct_remaining = diff / total_secs
                        tid_sub = sub['telegram_user_id']
                        bun = bot_config.get('bot_username', '')
                        pname = product.get('product_name', 'Unknown')
                        lang = get_user_language(tid_sub, sub.get('bot_id', ''))
                        
                        # Format remaining time
                        if diff >= 86400:
                            d = int(diff // 86400)
                            time_left = f"{d} {'día(s)' if lang == 'es' else 'dia(s)' if lang == 'pt' else 'jour(s)' if lang == 'fr' else 'day(s)'}"
                        elif diff >= 3600:
                            h = int(diff // 3600)
                            time_left = f"{h} {'hora(s)' if lang == 'es' else 'hora(s)' if lang == 'pt' else 'heure(s)' if lang == 'fr' else 'hour(s)'}"
                        elif diff >= 60:
                            m = int(diff // 60)
                            time_left = f"{m} {'minuto(s)' if lang == 'es' else 'minuto(s)' if lang == 'pt' else 'minute(s)' if lang == 'fr' else 'minute(s)'}"
                        else:
                            s = int(diff)
                            time_left = f"{s} {'segundo(s)' if lang == 'es' else 'segundo(s)' if lang == 'pt' else 'seconde(s)' if lang == 'fr' else 'second(s)'}"
                        
                        async def notify_user(msg_text, flag):
                            if bun in active_bots:
                                try:
                                    await active_bots[bun].bot.send_message(chat_id=tid_sub, text=msg_text)
                                except: pass
                            supabase.table('user_subscriptions').update({flag: True}).eq('id', sub['id']).execute()
                        
                        # 50% notification
                        if pct_remaining <= 0.50 and not sub.get('notified_1day'):
                            msg = t('sub_expiring', lang).replace('${product}', pname).replace('${time}', time_left)
                            await notify_user(msg, 'notified_1day')
                        
                        # 90% notification
                        if pct_remaining <= 0.10 and not sub.get('notified_15min'):
                            msg = t('sub_expiring_soon', lang).replace('${product}', pname).replace('${time}', time_left)
                            await notify_user(msg, 'notified_15min')
                        
                except Exception as e:
                    logger.error(f"Error processing subscription {sub.get('id')}: {e}")
        except Exception as e:
            logger.error(f"Error in check_expirations: {e}")
        
        await asyncio.sleep(60)

async def kick_user(sub, bot_config, product):
    """Kick a user from the channel/group when their subscription expires"""
    try:
        channel_id = product.get('channel_chat_id')
        if not channel_id:
            logger.error(f"No channel_chat_id for subscription {sub['id']}")
            supabase.table('user_subscriptions').update({'status': 'expired'}).eq('id', sub['id']).execute()
            return
        
        # Try link generator bot first, then main bot
        kick_bot = await get_or_create_link_gen_bot(bot_config, product)
        if not kick_bot:
            bun = bot_config.get('bot_username')
            if bun in active_bots:
                kick_bot = active_bots[bun].bot
        
        if not kick_bot:
            logger.error(f"No bot available to kick user {sub['telegram_user_id']}")
            return
        
        tid = sub['telegram_user_id']
        try:
            await kick_bot.ban_chat_member(chat_id=channel_id, user_id=tid)
            # Unban so user can rejoin later if they pay again
            await asyncio.sleep(1)
            await kick_bot.unban_chat_member(chat_id=channel_id, user_id=tid)
        except Exception as e:
            logger.error(f"Error kicking user {tid}: {e}")
        
        # Revoke invite link
        if sub.get('invite_link'):
            try:
                await kick_bot.revoke_chat_invite_link(chat_id=channel_id, invite_link=sub['invite_link'])
                logger.info(f"Revoked invite link for expired subscription {sub['id']}")
            except Exception as e:
                logger.error(f"Error revoking invite link: {e}")
        
        supabase.table('user_subscriptions').update({'status': 'expired', 'kicked_at': datetime.now().isoformat()}).eq('id', sub['id']).execute()
        
        # Notify user that subscription expired
        bun = bot_config.get('bot_username', '')
        if bun in active_bots:
            try:
                lang = get_user_language(tid, sub.get('bot_id', ''))
                msg = t('sub_expired', lang).replace('${product}', product.get('product_name', 'Unknown'))
                await active_bots[bun].bot.send_message(chat_id=tid, text=msg)
            except Exception as e:
                logger.error(f"Error notifying user about expiry: {e}")
        
        await send_admin_notification(f"❌ Subscription expired - User kicked\n\nUser: {sub.get('telegram_username', 'Unknown')} ({tid})\nProduct: {product.get('product_name', 'Unknown')}")
        logger.info(f"Kicked user {tid} from {channel_id}")
    except Exception as e:
        logger.error(f"Error in kick_user: {e}")


@app.post("/webhook/oxapay")
async def oxapay_webhook(request: Request):
    try:
        payload = await request.json()
        logger.info(f"OxaPay webhook: {payload}")
        status = payload.get('status', '')
        status = status.lower() if isinstance(status, str) else ''
        oid = payload.get('orderId', '') or payload.get('order_id', '')
        if status not in ['paid', 'confirmed', 'complete']:
            return {"status": "ignored"}
        
        # Handle balance recharge: rc_{bot_id8}_{uid}_{ts}
        if oid.startswith('rc_'):
            parts = oid.split('_')
            bid_short, tid = parts[1], int(parts[2])
            # Find bot
            br = supabase.table('bots').select('*').execute()
            bot_config = None
            for b in (br.data or []):
                if b['id'].startswith(bid_short):
                    bot_config = b
                    break
            if not bot_config: return {"status": "error"}
            # Get amount from payload
            amount = float(payload.get('amount', 0))
            if amount > 0:
                tk = payload.get('trackId', '') or payload.get('track_id', '')
                # Avoid duplicates
                ex = supabase.table('balance_transactions').select('id').eq('reference', f"CRYPTO_RECHARGE_{tk}").execute()
                if not ex.data:
                    add_balance_transaction(tid, bot_config['id'], amount, 'recharge', reference=f"CRYPTO_RECHARGE_{tk}", description=f"Crypto recharge")
                    # Notify user
                    if bot_config['bot_username'] in active_bots:
                        try:
                            lang = get_user_language(tid, bot_config['id'])
                            new_bal = get_user_balance(tid, bot_config['id'])
                            await active_bots[bot_config['bot_username']].bot.send_message(chat_id=tid, text=t('balance_recharged', lang, balance=f"{new_bal:.2f}"))
                        except Exception as e:
                            logger.error(f"Error notifying recharge: {e}")
                    await send_admin_notification(f"Balance recharge\n\nUser ID: {tid}\nAmount: ${amount}\nMethod: Crypto")
            return {"status": "success"}
        
        if not oid.startswith('cx_'):
            return {"status": "ignored"}
        parts = oid.split('_')
        # cx_{sp}_{tid}_{ts} OR cx_{sp}_{plan_short}_{tid}_{ts}
        sp = parts[1]
        if len(parts) == 5:
            plan_short = parts[2]
            tid = int(parts[3])
        else:
            plan_short = None
            tid = int(parts[2])
        
        all_prods = supabase.table('products').select('*').execute()
        pr_data = [p for p in (all_prods.data or []) if p['id'].startswith(sp)]
        if not pr_data: return {"status": "error"}
        p = pr_data[0]
        br = supabase.table('bots').select('*').eq('id', p['bot_id']).execute()
        if not br.data: return {"status": "error"}
        bc = br.data[0]
        plan = find_plan_by_short(plan_short, p['id']) if plan_short else None
        
        # Look up username from pending_purchases
        uname = "Unknown"
        try:
            pend = supabase.table('pending_purchases').select('telegram_username').eq('telegram_user_id', tid).eq('product_id', p['id']).order('created_at', desc=True).limit(1).execute()
            if pend.data and pend.data[0].get('telegram_username'):
                uname = pend.data[0]['telegram_username']
        except Exception as e:
            logger.error(f"Error looking up username: {e}")
        
        # Check active coupon for redemption
        active_coupon = get_active_coupon(tid, bc['id'])
        
        ok = await BotManager.deliver_purchase(bc['bot_username'], tid, p, bc, plan, uname)
        logger.info(f"Crypto delivery result: ok={ok}, product={p['product_name']}, user={tid}")
        if ok:
            tk = payload.get('trackId', '') or payload.get('track_id', '')
            ex = supabase.table('sales').select('id').eq('hotmart_transaction_id', f"CRYPTO_{tk}").execute()
            logger.info(f"Crypto duplicate check: exists={bool(ex.data)}, tk={tk}")
            if not ex.data:
                supabase.table('sales').insert({'bot_id': p['bot_id'], 'product_id': p['id'], 'telegram_user_id': tid, 'telegram_username': uname, 'hotmart_transaction_id': f"CRYPTO_{tk}", 'payment_method': 'Crypto', 'amount': p['price'], 'status': 'completed'}).execute()
                logger.info(f"Crypto sale inserted, sending notification...")
                await send_sale_notification(p['product_name'], p['price'], p.get('currency', 'USD'), 'Crypto', tid, uname, plan['plan_name'] if plan else None)
                logger.info(f"Crypto sale notification sent")
                # Redeem coupon if applied
                if active_coupon:
                    redeem_coupon(tid, bc['id'], active_coupon['id'], sale_reference=f"CRYPTO_{tk}")
        return {"status": "success"}
    except Exception as e:
        logger.error(f"OxaPay error: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))

