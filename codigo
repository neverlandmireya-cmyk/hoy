    except Exception as e:
        logger.error(f"Error in refund-sale: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))


@app.post("/approve-transfer")
async def approve_transfer(request: Request):
    """Approve a pending balance transfer"""
    try:
        body = await request.json()
        transfer_id = body.get('transfer_id')
        if not transfer_id:
            raise HTTPException(400, detail="transfer_id required")
        
        tr = supabase.table('balance_transfers').select('*').eq('id', transfer_id).limit(1).execute()
        if not tr.data:
            raise HTTPException(404, detail="Transfer not found")
        transfer = tr.data[0]
        
        if transfer['status'] != 'pending':
            raise HTTPException(400, detail="Transfer already processed")
        
        from_id = transfer['from_user_id']
        to_id = transfer['to_user_id']
        bot_id = transfer['bot_id']
        amount = float(transfer['amount'])
        
        # Check sender still has balance
        from_bal = get_user_balance(from_id, bot_id)
        if from_bal < amount:
            raise HTTPException(400, detail=f"Sender has insufficient balance (${from_bal:.2f})")
        
        # Deduct from sender
        new_from_bal = add_balance_transaction(from_id, bot_id, -amount, 'transfer_out', reference=f"TRANSFER_{transfer_id[:8]}", description=f"Transfer to {to_id}")
        
        # Add to recipient
        new_to_bal = add_balance_transaction(to_id, bot_id, amount, 'transfer_in', reference=f"TRANSFER_{transfer_id[:8]}", description=f"Transfer from {from_id}")
        
        # Mark as approved
        supabase.table('balance_transfers').update({
            'status': 'approved',
            'resolved_at': datetime.now().isoformat()
        }).eq('id', transfer_id).execute()
        
        # Notify sender
        try:
            br = supabase.table('bots').select('bot_username').eq('id', bot_id).limit(1).execute()
            logger.info(f"Transfer notify: bot lookup result: {br.data}")
            if br.data:
                bun = br.data[0]['bot_username']
                logger.info(f"Transfer notify: looking for bot {bun} in active_bots: {bun in active_bots}")
                if bun in active_bots:
                    lang_from = get_user_language(from_id, bot_id)
                    msg = t('transfer_approved', lang_from).replace('${amount}', f'{amount:.2f}').replace('${balance}', f'{(new_from_bal or 0):.2f}')
                    try:
                        await active_bots[bun].bot.send_message(chat_id=from_id, text=msg)
                        logger.info(f"Transfer approved notification sent to sender {from_id}")
                    except Exception as e:
                        logger.error(f"Failed to notify sender {from_id}: {e}")
                    # Notify recipient
                    lang_to = get_user_language(to_id, bot_id)
                    msg2 = t('transfer_received', lang_to).replace('${amount}', f'{amount:.2f}').replace('${balance}', f'{(new_to_bal or 0):.2f}')
                    try:
                        await active_bots[bun].bot.send_message(chat_id=to_id, text=msg2)
                        logger.info(f"Transfer received notification sent to recipient {to_id}")
                    except Exception as e:
                        logger.error(f"Failed to notify recipient {to_id}: {e}")
        except Exception as e:
            logger.error(f"Error notifying transfer: {e}", exc_info=True)
        
        # Admin notification
        await send_admin_notification(f"Transfer approved\n\nFrom: {from_id}\nTo: {to_id}\nAmount: ${amount:.2f}")
        
        logger.info(f"Transfer approved: {transfer_id}, from {from_id} to {to_id}, ${amount}")
        return {"status": "success", "from_balance": new_from_bal, "to_balance": new_to_bal}
    except HTTPException: raise
    except Exception as e:
        logger.error(f"Error approving transfer: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))


@app.post("/reject-transfer")
async def reject_transfer(request: Request):
    """Reject a pending balance transfer"""
    try:
        body = await request.json()
        transfer_id = body.get('transfer_id')
        reason = body.get('reason', '')
        if not transfer_id:
            raise HTTPException(400, detail="transfer_id required")
        
        tr = supabase.table('balance_transfers').select('*').eq('id', transfer_id).limit(1).execute()
        if not tr.data:
            raise HTTPException(404, detail="Transfer not found")
        transfer = tr.data[0]
        
        if transfer['status'] != 'pending':
            raise HTTPException(400, detail="Transfer already processed")
        
        # Mark as rejected
        supabase.table('balance_transfers').update({
            'status': 'rejected',
            'resolved_at': datetime.now().isoformat(),
            'admin_note': reason or None
        }).eq('id', transfer_id).execute()
        
        # Notify sender
        try:
            br = supabase.table('bots').select('bot_username').eq('id', transfer['bot_id']).limit(1).execute()
            if br.data:
                bun = br.data[0]['bot_username']
                if bun in active_bots:
                    lang = get_user_language(transfer['from_user_id'], transfer['bot_id'])
                    msg = t('transfer_rejected', lang).replace('${amount}', f"{float(transfer['amount']):.2f}")
                    try:
                        await active_bots[bun].bot.send_message(chat_id=transfer['from_user_id'], text=msg)
                        logger.info(f"Transfer rejection notification sent to {transfer['from_user_id']}")
                    except Exception as e:
                        logger.error(f"Failed to notify rejection to {transfer['from_user_id']}: {e}")
        except Exception as e:
            logger.error(f"Error notifying rejection: {e}", exc_info=True)
        
        await send_admin_notification(f"Transfer rejected\n\nFrom: {transfer['from_user_id']}\nTo: {transfer['to_user_id']}\nAmount: ${float(transfer['amount']):.2f}\nReason: {reason or 'N/A'}")
        
        logger.info(f"Transfer rejected: {transfer_id}, reason: {reason}")
        return {"status": "success"}
    except HTTPException: raise
    except Exception as e:
        logger.error(f"Error rejecting transfer: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))

