    @staticmethod
    async def load_and_start_all_bots():
        try:
            r = supabase.table('bots').select('*').eq('is_active', True).execute()
            if not r.data: return
            tasks = []
            for b in r.data:
                if b['bot_username'] not in active_bots:
                    tasks.append(BotManager.start_bot(b['bot_token'], b['bot_username']))
                # Also start stars bot if configured
                sb_token = b.get('stars_bot_token')
                sb_bun = b.get('stars_bot_username')
                if sb_token and sb_bun and sb_bun not in stars_bots:
                    tasks.append(BotManager.start_stars_bot(sb_token, sb_bun, b['bot_username']))
            # Also start product-level stars bots
            try:
                prods = supabase.table('products').select('stars_bot_token, stars_bot_username').eq('is_active', True).execute()
                for p in (prods.data or []):
                    ps_token = p.get('stars_bot_token')
                    ps_bun = p.get('stars_bot_username')
                    if ps_token and ps_bun and ps_bun not in stars_bots:
                        tasks.append(BotManager.start_stars_bot(ps_token, ps_bun, 'product_level'))
            except: pass
            if tasks: await asyncio.gather(*tasks)
        except Exception as e:
            logger.error(f"Error loading bots: {e}")

    @staticmethod
    async def stop_all_bots():
        for bun, a in active_bots.items():
            try: await a.updater.stop(); await a.stop(); await a.shutdown()
            except: pass
        active_bots.clear()
        for bun, a in stars_bots.items():
