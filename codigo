    @staticmethod
    async def receive_proof(update: Update, context: ContextTypes.DEFAULT_TYPE):
        lang = context.user_data.get('mp_lang', 'en')
        logger.info(f"receive_proof called, photo={bool(update.message.photo)}, doc={bool(update.message.document)}")
        if update.message.photo:
            f = await update.message.photo[-1].get_file()
        elif update.message.document:
            f = await update.message.document.get_file()
        else:
            await update.message.reply_text(t('invalid_proof', lang))
            return WAITING_PROOF
        try:
            insert_data = {
                'product_id': context.user_data['mp_product_id'],
                'telegram_user_id': context.user_data['mp_uid'],
                'telegram_username': context.user_data['mp_uname'],
                'email': context.user_data.get('mp_email', 'n/a'),
                'transaction_id': context.user_data.get('mp_code', '') or context.user_data.get('mp_transaction', 'n/a'),
                'payment_proof_url': f.file_path, 'status': 'pending'
            }
            plan_id = context.user_data.get('mp_plan_id')
            if plan_id:
                insert_data['plan_id'] = plan_id
            supabase.table('manual_payments').insert(insert_data).execute()
            await update.message.reply_text(t('proof_submitted', lang), reply_markup=ReplyKeyboardRemove())
            logger.info(f"Payment proof submitted by {context.user_data.get('mp_uid')}")
        except Exception as e:
            logger.error(f"Error saving manual payment: {e}", exc_info=True)
            await update.message.reply_text(t('proof_error', lang))
        context.user_data.clear()
        return ConversationHandler.END

