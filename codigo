def build_payment_buttons_for_plan(product, plan, sck, lang, bot_id, uid=None):
    """Build payment buttons using plan price instead of product price"""
    order = get_global_payment_order()
    kb = []
    price = float(plan['price']) if plan else float(product['price'])
    plan_short = plan['id'][:8] if plan else ''
    logger.info(f"Payment order: {order}")
    
    for method in order:
        if method == "hotmart" and product.get('enable_hotmart'):
            url = (plan.get('hotmart_checkout_url') if plan else None) or product.get('hotmart_payment_url', '')
            if url:
                purl = f"{url}&sck={sck}" if '?' in url else f"{url}?sck={sck}"
                kb.append([InlineKeyboardButton(t('pay_cards', lang), url=purl)])
        elif method == "manual":
            methods = get_methods_for_product(product['id'], bot_id)
            for mm in methods:
                btn = mm['method_name']
                cb = f"mm_{product['id']}_{mm['id'][:8]}"
                if plan_short: cb += f"_{plan_short}"
                kb.append([InlineKeyboardButton(btn, callback_data=cb[:64])])
        elif method == "stars" and product.get('enable_telegram_stars'):
            sp = (plan.get('telegram_stars_price') if plan else product.get('telegram_stars_price')) or product.get('telegram_stars_price')
            if sp:
                cb = f"stars_{product['id']}"
                if plan_short: cb += f"_{plan_short}"
                kb.append([InlineKeyboardButton(t('pay_stars', lang), callback_data=cb[:64])])
        elif method == "crypto" and product.get('enable_crypto'):
            cp = price
            if cp:
                cb = f"crypto_{product['id']}"
                if plan_short: cb += f"_{plan_short}"
                kb.append([InlineKeyboardButton(t('pay_crypto', lang), callback_data=cb[:64])])
        elif method == "balance" and uid:
            cb = f"paybal_{product['id']}"
            if plan_short: cb += f"_{plan_short}"
            kb.append([InlineKeyboardButton(t('pay_with_balance_btn', lang), callback_data=cb[:64])])
    
    # Fallback: if "balance" not in order, still show it at the end
    if uid and "balance" not in order:
        cb = f"paybal_{product['id']}"
        if plan_short: cb += f"_{plan_short}"
        kb.append([InlineKeyboardButton(t('pay_with_balance_btn', lang), callback_data=cb[:64])])
    
    return kb

def build_payment_buttons(product, sck, lang='en', bot_id=None, uid=None):
    return build_payment_buttons_for_plan(product, None, sck, lang, bot_id or product.get('bot_id', ''), uid)

