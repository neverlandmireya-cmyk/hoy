                        msg += f"\n📝 {note}"
                    await active_bots[bun].bot.send_message(chat_id=tid, text=msg)
                    logger.info(f"Admin balance notification sent to {tid}")
                else:
                    logger.error(f"Admin balance notify: bot {bun} not in active_bots")
        except Exception as e:
            logger.error(f"Error notifying user about balance: {e}", exc_info=True)
        logger.info(f"Admin balance change for user {tid}: {amount} ({note})")
        return {"status": "success", "new_balance": new_bal}
    except HTTPException: raise
    except Exception as e:
        logger.error(f"Error in admin-add-balance: {e}", exc_info=True)
        raise HTTPException(500, detail=str(e))


@app.post("/refund-sale")
async def refund_sale(request: Request):
    """Refund a sale: return amount to user balance, mark sale as refunded, optionally remove access"""
    try:
        body = await request.json()
        sale_id = body.get('sale_id')
        remove_access = bool(body.get('remove_access', True))
        
        if not sale_id:
            raise HTTPException(400, detail="sale_id required")
        
        # Get the sale
        sr = supabase.table('sales').select('*').eq('id', sale_id).limit(1).execute()
        if not sr.data:
            raise HTTPException(404, detail="Sale not found")
        sale = sr.data[0]
        
        if sale.get('status') == 'refunded':
            raise HTTPException(400, detail="Sale already refunded")
        
        tid = sale['telegram_user_id']
        bot_id = sale['bot_id']
        product_id = sale.get('product_id')
        amount = float(sale.get('amount', 0))
        
        # 1. Refund to balance
        if amount > 0:
            new_bal = add_balance_transaction(tid, bot_id, amount, 'refund', reference=f"REFUND_{sale_id[:8]}", description=f"Refund: {sale_id[:8]}")
        else:
            new_bal = get_user_balance(tid, bot_id)
        
        # 2. Mark sale as refunded
        supabase.table('sales').update({'status': 'refunded'}).eq('id', sale_id).execute()
        
        # 3. Remove access if requested
        kicked = 0
        if remove_access and product_id:
            _, _, _, kicked = await _do_remove_access(tid, bot_id, product_id, kick=True)
        
        # 4. Notify user
        try:
            br = supabase.table('bots').select('bot_username').eq('id', bot_id).limit(1).execute()
            logger.info(f"Refund notify: bot lookup: {br.data}, bot_id: {bot_id}")
            if br.data:
                bun = br.data[0]['bot_username']
                logger.info(f"Refund notify: bot {bun}, in active_bots: {bun in active_bots}")
                if bun in active_bots:
                    lang = get_user_language(tid, bot_id)
                    refund_msg = t('refund_notification', lang).replace('${amount}', f'{amount:.2f}').replace('${balance}', f'{(new_bal or 0):.2f}')
                    logger.info(f"Refund notify: sending to {tid}: {refund_msg}")
                    await active_bots[bun].bot.send_message(chat_id=tid, text=f"💸 {refund_msg}")
                    logger.info(f"Refund notification sent to {tid}")
                else:
                    logger.error(f"Refund notify: bot {bun} not in active_bots. Active: {list(active_bots.keys())}")
            else:
                logger.error(f"Refund notify: no bot found for id {bot_id}")
        except Exception as e:
            logger.error(f"Error notifying refund: {e}", exc_info=True)
        
        # 5. Admin notification
        await send_admin_notification(f"Refund processed\n\nSale: {sale_id[:8]}\nUser: {tid}\nAmount: ${amount}\nKicked: {'Yes' if kicked else 'No'}")
        
        logger.info(f"Refund: sale {sale_id}, user {tid}, amount ${amount}, kicked={kicked}")
        return {"status": "success", "refunded_amount": amount, "new_balance": new_bal, "kicked_channels": kicked}
