        logger.error(f"Error updating balance: {e}", exc_info=True)
        return None

def get_active_coupon(tid, bot_id):
    """Get user's currently active coupon (entered via /coupon)"""
    try:
        r = supabase.table('user_active_coupons').select('coupon_id').eq('telegram_user_id', tid).eq('bot_id', bot_id).limit(1).execute()
        if not r.data: return None
        cid = r.data[0]['coupon_id']
        cr = supabase.table('coupons').select('*').eq('id', cid).eq('is_active', True).limit(1).execute()
        if not cr.data: return None
        c = cr.data[0]
        # Check expiration
        if c.get('expires_at'):
            try:
                exp = datetime.fromisoformat(c['expires_at'].replace('Z', '+00:00')).replace(tzinfo=None)
                if exp < datetime.now(): return None
            except: pass
        # Check max uses
        if c.get('max_uses') and c.get('current_uses', 0) >= c['max_uses']:
            return None
        return c
    except: pass
    return None

def apply_coupon_discount(price, coupon, method, product=None):
    """Apply coupon to price for a specific payment method. Returns (final_price, applied)"""
    if not coupon: return price, False
    # Skip if product is excluded from coupons
    if product and product.get('exclude_from_coupons'):
        return price, False
    method_field = f"applies_to_{method}"
    if not coupon.get(method_field, True): return price, False
    discount_type = coupon.get('discount_type', 'percent')
    discount_value = float(coupon.get('discount_value', 0))
    if discount_type == 'percent':
        return max(0, price * (1 - discount_value / 100)), True
    else:  # fixed
        return max(0, price - discount_value), True

def redeem_coupon(tid, bot_id, coupon_id, sale_reference=None):
    """Mark coupon as redeemed and increment usage"""
    try:
        # Update activation row
        supabase.table('coupon_activations').update({
            'redeemed_at': datetime.now().isoformat()
        }).eq('coupon_id', coupon_id).eq('telegram_user_id', tid).is_('redeemed_at', 'null').execute()
        # Increment usage counter
        cr = supabase.table('coupons').select('current_uses').eq('id', coupon_id).limit(1).execute()
        if cr.data:
            cu = (cr.data[0].get('current_uses', 0) or 0) + 1
            supabase.table('coupons').update({'current_uses': cu}).eq('id', coupon_id).execute()
        # Clear active coupon
        supabase.table('user_active_coupons').delete().eq('telegram_user_id', tid).eq('bot_id', bot_id).execute()
    except Exception as e:
        logger.error(f"Error redeeming coupon: {e}")

