def get_bot_languages(bot_id):
    global cached_bot_languages, cached_bot_languages_time
    now = datetime.now()
    if bot_id in cached_bot_languages and bot_id in cached_bot_languages_time and (now - cached_bot_languages_time[bot_id]).total_seconds() < 300:
        return cached_bot_languages[bot_id]
    
    LANG_ORDER = ['en', 'es', 'pt', 'fr']
    try:
        r = supabase.table('bot_languages').select('language_code').eq('bot_id', bot_id).eq('is_enabled', True).execute()
        if r.data:
            enabled = set(x['language_code'] for x in r.data)
            # Sort by preferred order
            ordered = [lc for lc in LANG_ORDER if lc in enabled]
            cached_bot_languages[bot_id] = ordered
            cached_bot_languages_time[bot_id] = now
            return ordered
    except: pass
    # Default to all 4 languages in preferred order
    return LANG_ORDER

def t(key, lang, **kw):
    tr = DEFAULT_TRANSLATIONS.get(lang, DEFAULT_TRANSLATIONS['en'])
    txt = tr.get(key, DEFAULT_TRANSLATIONS['en'].get(key, key))
    if kw:
        try: txt = txt.format(**kw)
        except: pass
    return txt

