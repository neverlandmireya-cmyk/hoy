def format_duration(minutes):
    if not minutes or minutes == 0: return None
    if minutes < 60: return f"{minutes}m"
    if minutes < 1440: return f"{minutes // 60}h"
    return f"{minutes // 1440}d"

def next_step(ctx, lang):
    step = ctx.user_data.get('mp_step', 'start')
    if step == 'start' and ctx.user_data.get('mp_req_email'):
        ctx.user_data['mp_step'] = 'email'
        return WAITING_EMAIL, t('send_email', lang)
    if step in ('start', 'email') and ctx.user_data.get('mp_req_trans'):
        ctx.user_data['mp_step'] = 'transaction'
        return WAITING_TRANSACTION, t('send_transaction', lang)
    if step in ('start', 'email', 'transaction') and ctx.user_data.get('mp_req_code'):
        ctx.user_data['mp_step'] = 'code'
        return WAITING_CODE, t('send_code', lang)
    ctx.user_data['mp_step'] = 'proof'
    return WAITING_PROOF, t('send_proof', lang)


class BotManager:
    @staticmethod
    async def load_products(bot_id):
        try:
            r = supabase.table('products').select('*').eq('bot_id', bot_id).eq('is_active', True).order('display_order').execute()
            return r.data or []
        except: return []

    @staticmethod
    async def load_categories(bot_id):
        try:
            r = supabase.table('categories').select('*').eq('bot_id', bot_id).eq('is_active', True).order('display_order').execute()
            logger.info(f"load_categories: bot={bot_id}, found={len(r.data or [])}")
            return r.data or []
        except Exception as e:
            logger.error(f"load_categories error: {e}")
            return []

    @staticmethod
    async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
        uid = update.effective_user.id
        # Clear any waiting states
        for k in ['waiting_coupon', 'waiting_recharge', 'waiting_transfer_amount', 'waiting_transfer_id', 'waiting_bug']:
            context.user_data.pop(k, None)
        r = supabase.table('bots').select('*').eq('bot_username', context.bot.username).eq('is_active', True).execute()
        if not r.data:
            await update.message.reply_text("Bot not found.")
            return
        bc = r.data[0]
        # Check if user is banned
        if is_user_banned(uid, bc['id']):
