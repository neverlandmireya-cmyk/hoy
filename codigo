    @staticmethod
    async def deliver_purchase(bot_username, tid, product, bc, plan, uname):
        """Deliver purchase: auto-generated invite link if channel_chat_id exists, else invite codes"""
        try:
            if bot_username not in active_bots: return False
            a = active_bots[bot_username]
            lang = get_user_language(tid, bc['id'])
            ex = supabase.table('sales').select('id').eq('telegram_user_id', tid).eq('product_id', product['id']).eq('status', 'completed').execute()
            if ex.data:
                # For subscription products, check if subscription is still active
                if plan:
                    active_sub = supabase.table('user_subscriptions').select('id').eq('telegram_user_id', tid).eq('product_id', product['id']).eq('status', 'active').execute()
                    if not active_sub.data:
                        pass  # Subscription expired, allow re-purchase
                    else:
                        await a.bot.send_message(chat_id=tid, text=t('already_access', lang))
                        return True
                else:
                    await a.bot.send_message(chat_id=tid, text=t('already_access', lang))
                    return True
            
            invite_link = None
            
            if product.get('channel_chat_id'):
                # Auto-generate invite link (works for both subscriptions and one-time purchases)
                invite_link = await generate_invite_link(bc, product, tid, uname)
                if not invite_link:
                    await a.bot.send_message(chat_id=tid, text=t('invite_error', lang))
                    return False
                
                if plan:
                    # Subscription: save with expiration
                    duration = plan.get('duration_minutes', 0)
                    expires_at = None if not duration else (datetime.now() + timedelta(minutes=duration))
                    sub_data = {
                        'telegram_user_id': tid,
                        'telegram_username': uname,
                        'product_id': product['id'],
                        'bot_id': bc['id'],
                        'plan_id': plan['id'],
                        'invite_link': invite_link,
                        'expires_at': expires_at.isoformat() if expires_at else None,
                        'status': 'active'
                    }
                    try:
                        supabase.table('user_subscriptions').insert(sub_data).execute()
                    except Exception as e:
                        logger.error(f"Error saving subscription: {e}")
                    exp_text = expires_at.strftime('%Y-%m-%d %H:%M UTC') if expires_at else t('permanent', lang)
                    msg = t('subscription_message', lang, plan_name=plan['plan_name'], expires=exp_text, invite_link=invite_link)
                    await a.bot.send_message(chat_id=tid, text=msg)
                else:
                    # One-time purchase with auto invite link - save link for /myaccess
                    try:
                        supabase.table('user_subscriptions').insert({
                            'telegram_user_id': tid, 'telegram_username': uname,
                            'product_id': product['id'], 'bot_id': bc['id'],
                            'invite_link': invite_link, 'status': 'active'
                        }).execute()
                    except Exception as e:
                        logger.error(f"Error saving invite link for one-time purchase: {e}")
                    await a.bot.send_message(chat_id=tid, text=t('purchase_message', lang).replace('{invite_link}', invite_link))
                return True
            
            # Fallback to invite_codes (no channel_chat_id)
            icr = supabase.table('invite_codes').select('*').eq('product_id', product['id']).eq('is_used', False).limit(1).execute()
            if icr.data:
                ic = icr.data[0]
                invite_link = ic['code']
                supabase.table('invite_codes').update({'is_used': True, 'used_by_telegram_user_id': tid, 'used_at': datetime.now().isoformat()}).eq('id', ic['id']).execute()
            else:
                invite_link = product.get('invite_link')
            
            if not invite_link:
                await a.bot.send_message(chat_id=tid, text=t('invite_error', lang))
                return False
            
            await a.bot.send_message(chat_id=tid, text=t('purchase_message', lang).replace('{invite_link}', invite_link))
            return True
        except Exception as e:
            logger.error(f"Error delivering purchase: {e}")
            return False

