        oid = f"cx_{pid[:8]}{plan_part}_{tid}_{int(datetime.now().timestamp())}"
        payload = {'amount': round(float(amt), 2), 'currency': 'USD', 'life_time': 30, 'fee_paid_by_payer': 1, 'under_paid_coverage': 10, 'callback_url': 'https://he.nothumxn.com/webhook/oxapay', 'return_url': 'https://t.me/', 'description': str(pname)[:64], 'order_id': str(oid)[:50], 'email': 'noreply@bot.com'}
