            raise HTTPException(400, detail="telegram_user_id, bot_id and non-zero amount required")
        type_ = 'admin_add' if amount > 0 else 'admin_remove'
        new_bal = add_balance_transaction(tid, bot_id, amount, type_, description=f"Admin {'added' if amount > 0 else 'removed'} ${abs(amount)}", admin_note=note)
        if new_bal is None:
            raise HTTPException(500, detail="Failed to update balance")
        # Notify user if bot is running
        try:
            br = supabase.table('bots').select('bot_username').eq('id', bot_id).limit(1).execute()
            logger.info(f"Admin balance notify: bot lookup: {br.data}")
            if br.data:
                bun = br.data[0]['bot_username']
                if bun in active_bots:
                    lang = get_user_language(tid, bot_id)
                    sign = "+" if amount > 0 else "-"
                    msg = f"{sign}${abs(amount):.2f} → {t('balance_current', lang)} ${new_bal:.2f}"
