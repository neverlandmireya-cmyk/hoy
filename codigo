async def _do_remove_access(tid: int, bot_id: str, product_id: Optional[str] = None, kick: bool = False):
    """Internal function to remove access for a user. Used by both /remove-access and /ban-user endpoints."""
    sales_q = supabase.table('sales').select('*').eq('telegram_user_id', tid).eq('bot_id', bot_id)
    if product_id: sales_q = sales_q.eq('product_id', product_id)
    sales_r = sales_q.execute()
    sales_count = len(sales_r.data or [])
    
    subs_q = supabase.table('user_subscriptions').select('*').eq('telegram_user_id', tid).eq('bot_id', bot_id)
    if product_id: subs_q = subs_q.eq('product_id', product_id)
    subs_r = subs_q.execute()
    subs_count = len(subs_r.data or [])
    
    affected_product_ids = set()
    for s in (sales_r.data or []): affected_product_ids.add(s.get('product_id'))
    for s in (subs_r.data or []): affected_product_ids.add(s.get('product_id'))
    
    codes_count = 0
    for pid in affected_product_ids:
        if not pid: continue
        ic_r = supabase.table('invite_codes').select('id').eq('used_by_telegram_user_id', tid).eq('product_id', pid).execute()
        codes_count += len(ic_r.data or [])
        for c in (ic_r.data or []):
            supabase.table('invite_codes').update({'is_used': False, 'used_by_telegram_user_id': None, 'used_at': None}).eq('id', c['id']).execute()
    
    kicked_channels = []
    if kick:
        bc_r = supabase.table('bots').select('*').eq('id', bot_id).execute()
        bot_config = bc_r.data[0] if bc_r.data else {}
        for pid in affected_product_ids:
            if not pid: continue
            pr = supabase.table('products').select('channel_chat_id, link_generator_bot_token').eq('id', pid).limit(1).execute()
            if pr.data and pr.data[0].get('channel_chat_id'):
                channel_id = pr.data[0]['channel_chat_id']
                kick_bot = await get_or_create_link_gen_bot(bot_config, pr.data[0])
                if not kick_bot:
                    bun = bot_config.get('bot_username')
                    if bun in active_bots: kick_bot = active_bots[bun].bot
                if kick_bot:
                    try:
                        await kick_bot.ban_chat_member(chat_id=channel_id, user_id=tid)
                        await asyncio.sleep(1)
                        await kick_bot.unban_chat_member(chat_id=channel_id, user_id=tid)
                        kicked_channels.append(channel_id)
                    except Exception as e:
                        logger.error(f"Error kicking from {channel_id}: {e}")
                    # Revoke invite links for this user
                    try:
                        subs_links = supabase.table('user_subscriptions').select('invite_link').eq('telegram_user_id', tid).eq('product_id', pid).execute()
                        for sl in (subs_links.data or []):
                            if sl.get('invite_link'):
                                try:
                                    await kick_bot.revoke_chat_invite_link(chat_id=channel_id, invite_link=sl['invite_link'])
                                    logger.info(f"Revoked invite link for user {tid}")
                                except Exception as e:
                                    logger.error(f"Error revoking invite link: {e}")
                    except Exception as e:
                        logger.error(f"Error looking up invite links to revoke: {e}")
    
    del_sales = supabase.table('sales').delete().eq('telegram_user_id', tid).eq('bot_id', bot_id)
    if product_id: del_sales = del_sales.eq('product_id', product_id)
    del_sales.execute()
    
    del_subs = supabase.table('user_subscriptions').delete().eq('telegram_user_id', tid).eq('bot_id', bot_id)
    if product_id: del_subs = del_subs.eq('product_id', product_id)
    del_subs.execute()
    
    del_pend = supabase.table('pending_purchases').delete().eq('telegram_user_id', tid).eq('bot_id', bot_id)
    if product_id: del_pend = del_pend.eq('product_id', product_id)
    del_pend.execute()
    
    return sales_count, subs_count, codes_count, len(kicked_channels)


