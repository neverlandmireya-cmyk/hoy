    @staticmethod
    async def myaccess_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
        """Show user's purchases and access links"""
        for k in ['waiting_coupon', 'waiting_recharge', 'waiting_transfer_amount', 'waiting_transfer_id', 'waiting_bug']:
            context.user_data.pop(k, None)
        uid = update.effective_user.id
        r = supabase.table('bots').select('*').eq('bot_username', context.bot.username).eq('is_active', True).execute()
        if not r.data: return
        bc = r.data[0]
        bot_id = bc['id']
        lang = get_user_language(uid, bot_id)
        
        def esc(s):
            """Escape markdown special chars"""
            if not s: return ""
            return str(s).replace('\\', '\\\\').replace('_', '\\_').replace('*', '\\*').replace('[', '\\[').replace('`', '\\`')
        
        messages = []
        
        # Get active subscriptions
        try:
            subs = supabase.table('user_subscriptions').select('*').eq('telegram_user_id', uid).eq('bot_id', bot_id).in_('status', ['active']).execute()
            for sub in (subs.data or []):
                try:
                    product_name = "Unknown"
                    product_access_link = None
                    plan_name = ""
                    if sub.get('product_id'):
                        p = supabase.table('products').select('product_name, access_link, channel_chat_id').eq('id', sub['product_id']).limit(1).execute()
                        if p.data:
                            product_name = p.data[0]['product_name']
                            # Only use access_link for channel/group products
                            if p.data[0].get('channel_chat_id'):
                                product_access_link = p.data[0].get('access_link')
                    if sub.get('plan_id'):
                        pl = supabase.table('subscription_plans').select('plan_name').eq('id', sub['plan_id']).limit(1).execute()
                        if pl.data: plan_name = pl.data[0]['plan_name']
                    
                    if sub.get('expires_at'):
                        try:
                            expires_at = datetime.fromisoformat(sub['expires_at'].replace('Z', '+00:00')).replace(tzinfo=None)
                            if expires_at > datetime.now():
                                status = t('myaccess_status_active', lang)
                                expires_text = expires_at.strftime('%Y-%m-%d %H:%M UTC')
                            else:
                                continue
                        except:
                            status = t('myaccess_status_active', lang)
                            expires_text = "—"
                    else:
                        status = t('myaccess_status_permanent', lang)
                        expires_text = t('forever', lang)
                    
                    block = f"━━━━━━━━━━━━━━\n"
                    block += f"*{t('myaccess_product', lang)}* {esc(product_name)}\n"
                    if plan_name:
                        block += f"*{t('myaccess_plan', lang)}* {esc(plan_name)}\n"
                    block += f"*{t('myaccess_status', lang)}* {status}\n"
                    block += f"*{t('myaccess_expires', lang)}* {esc(expires_text)}\n"
                    final_link = sub.get('invite_link') or product_access_link
                    if final_link:
                        block += f"*{t('myaccess_link', lang)}* {esc(final_link)}\n"
                    messages.append(block)
                except Exception as e:
                    logger.error(f"Error processing sub {sub.get('id')}: {e}")
                    continue
        except Exception as e:
            logger.error(f"Error loading subscriptions for /myaccess: {e}")
        
        # Get completed one-time purchases (non-subscription)
        try:
            sales = supabase.table('sales').select('*').eq('telegram_user_id', uid).eq('bot_id', bot_id).eq('status', 'completed').execute()
            for sale in (sales.data or []):
                try:
                    if not sale.get('product_id'): continue
                    # Skip if it's a subscription (already shown above)
                    sub_check = supabase.table('user_subscriptions').select('id').eq('telegram_user_id', uid).eq('product_id', sale['product_id']).execute()
                    if sub_check.data: continue
                    
                    product_name = "Unknown"
                    product_link = None
                    has_channel = False
                    p = supabase.table('products').select('product_name, access_link, invite_link, channel_chat_id').eq('id', sale['product_id']).limit(1).execute()
                    if p.data:
                        product_name = p.data[0]['product_name']
                        has_channel = bool(p.data[0].get('channel_chat_id'))
                    
                    # Check for saved invite link in user_subscriptions
                    saved_link = None
                    try:
                        sl = supabase.table('user_subscriptions').select('invite_link').eq('telegram_user_id', uid).eq('product_id', sale['product_id']).limit(1).execute()
                        if sl.data and sl.data[0].get('invite_link'):
                            saved_link = sl.data[0]['invite_link']
                    except: pass
                    
                    used_link = None
                    try:
                        ic = supabase.table('invite_codes').select('code').eq('used_by_telegram_user_id', uid).eq('product_id', sale['product_id']).limit(1).execute()
                        if ic.data: used_link = ic.data[0]['code']
                    except: pass
                    
                    block = f"━━━━━━━━━━━━━━\n"
                    block += f"*{t('myaccess_product', lang)}* {esc(product_name)}\n"
                    block += f"*{t('myaccess_status', lang)}* {t('myaccess_status_permanent', lang)}\n"
                    final_link = saved_link or used_link
                    if final_link:
                        block += f"*{t('myaccess_link', lang)}* {esc(final_link)}\n"
                    messages.append(block)
                except Exception as e:
                    logger.error(f"Error processing sale {sale.get('id')}: {e}")
                    continue
        except Exception as e:
            logger.error(f"Error loading sales for /myaccess: {e}")
        
        if not messages:
            await update.message.reply_text(t('myaccess_empty', lang))
            return
        
        full_msg = f"*{t('myaccess_title', lang)}*\n\n" + "\n".join(messages)
        try:
            if len(full_msg) > 4000:
                await update.message.reply_text(f"*{t('myaccess_title', lang)}*", parse_mode='Markdown')
                for m in messages:
                    try:
                        await update.message.reply_text(m, parse_mode='Markdown', disable_web_page_preview=True)
                    except Exception as e:
                        logger.error(f"Markdown failed, sending plain: {e}")
                        await update.message.reply_text(m.replace('*', '').replace('\\', ''), disable_web_page_preview=True)
            else:
                await update.message.reply_text(full_msg, parse_mode='Markdown', disable_web_page_preview=True)
        except Exception as e:
            logger.error(f"Error sending myaccess (falling back to plain): {e}")
            # Fallback: plain text
            try:
                plain = full_msg.replace('*', '').replace('\\', '')
                await update.message.reply_text(plain, disable_web_page_preview=True)
            except Exception as e2:
                logger.error(f"Even plain text failed: {e2}")
                await update.message.reply_text("Error showing your purchases. Please contact support.")

