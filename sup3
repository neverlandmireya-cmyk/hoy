# ALL tables to migrate (missing + re-import with pagination)
TABLES = [
    'app_settings',
    'banned_users',
    'bot_translations',
    'coupon_activations',
    'generator_bots',
    'gifts',
    'link_generation_logs',
    'manual_payment_methods',
    'payment_method_assignments',
    'pending_purchases',
    'subscriptions',
    'user_active_coupons',
    'webhook_logs',
    # Re-import these (were incomplete or wrong table name)
    'user_language_preferences',
    'invite_codes',
    'sales',
]

print("=" * 50)
print("STEP 1: EXPORT FROM OLD SUPABASE")
print("=" * 50)

exported = {}
for t in TABLES:
    try:
        # Paginate to get ALL rows (default limit is 1000)
        all_rows = []
        offset = 0
        batch_size = 1000
        while True:
            r = old.table(t).select('*').range(offset, offset + batch_size - 1).execute()
            rows = r.data or []
            all_rows.extend(rows)
            if len(rows) < batch_size:
                break
            offset += batch_size
        exported[t] = all_rows
        print(f"  ✅ {t}: {len(all_rows)} rows")
    except Exception as e:
        print(f"  ❌ {t}: {e}")
        exported[t] = []

# Save backup
with open('/tmp/supabase_backup_v2.json', 'w') as f:
    json.dump(exported, f, default=str)

print(f"\nTotal: {sum(len(v) for v in exported.values())} rows")

print("\n" + "=" * 50)
print("STEP 2: IMPORT TO NEW SUPABASE")
print("=" * 50)

for t in TABLES:
    data = exported.get(t, [])
    if not data:
        print(f"  ⏭️  {t}: empty")
        continue
    
    # Find bad columns
    bad_cols = set()
    test_row = copy.deepcopy(data[0])
    
    for attempt in range(20):
        for bc in bad_cols:
            test_row.pop(bc, None)
        try:
            new.table(t).upsert(test_row).execute()
            break
        except Exception as e:
            err_msg = str(e)
            match = re.search(r"Could not find the '(\w+)' column", err_msg)
            if match:
                bad_cols.add(match.group(1))
                continue
            elif "duplicate key" in err_msg or "unique" in err_msg.lower() or "already exists" in err_msg.lower():
                break
            else:
                print(f"    ⚠️  {t} first row: {err_msg[:120]}")
                break
    
    if bad_cols:
        print(f"  🔧 {t}: stripping {bad_cols}")
    
    success = 1  # first row already imported
    failed = 0
    
    for row in data[1:]:
        clean = {k: v for k, v in row.items() if k not in bad_cols}
        try:
            new.table(t).upsert(clean).execute()
            success += 1
        except Exception as e:
            err_msg = str(e)
            match = re.search(r"Could not find the '(\w+)' column", err_msg)
            if match:
                bad_cols.add(match.group(1))
                clean = {k: v for k, v in row.items() if k not in bad_cols}
                try:
                    new.table(t).upsert(clean).execute()
                    success += 1
                    continue
                except:
                    pass
            failed += 1
            if failed <= 2:
                print(f"    ❌ {err_msg[:120]}")
    
    print(f"  ✅ {t}: {success} imported, {failed} failed")
    time.sleep(0.3)

print("\n✅ ALL DONE!")
